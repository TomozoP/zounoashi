{
  "manifest_version": 3,
  "name": "Cake Cut → X",
  "version": "0.4",
  "description": "Cake Cut で書き出した動画と投稿文を、X の投稿画面にツリーで入れる",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.zounoashi.com/tools/short-editor/*", "http://localhost/tools/short-editor/*", "http://127.0.0.1/tools/short-editor/*"], "js": ["cakecut.js"] },
    { "matches": ["https://x.com/*"], "js": ["x.js"] }
  ]
}
